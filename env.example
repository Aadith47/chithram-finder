# Copy this file to .env and fill in your own keys. Never commit .env.

# Gemini (query generation): https://ai.google.dev/
GEMINI_API_KEY=

# OpenRouter (fallback language models and Jev ranking): https://openrouter.ai/
OPENROUTER_API_KEY=

# Pexels: https://www.pexels.com/api/
PEXELS_API_KEY=

# Unsplash: https://unsplash.com/developers (use the Access Key, not the Secret Key)
UNSPLASH_ACCESS_KEY=

# Pixabay: https://pixabay.com/api/docs/
PIXABAY_API_KEY=
